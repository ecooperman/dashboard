[Unit]
Description=Dashboard (sign-in front door and landing page)
After=network.target

[Service]
User=deploy
WorkingDirectory=/opt/apps/dashboard
# Settings every app shares (the issuer, the audience, ...) - see DEPLOYMENT.md "Shared secrets".
# The leading "-" means a missing file isn't an error.
EnvironmentFile=-/etc/personal-apps/shared.env
# THIS app's own secrets: the Auth0 client id and secret, the cookie domain and the hosts people
# may be sent back to. Root-only (600), on the droplet only, never in this repo and never in
# shared.env (every app reads that one). Read by systemd as root before dropping to User=deploy.
EnvironmentFile=-/etc/personal-apps/dashboard.env
ExecStart=/opt/apps/dashboard/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
